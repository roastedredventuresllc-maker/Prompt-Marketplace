modules = ["nodejs-24", "postgresql-16", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.build]
args = ["pnpm", "run", "build:vercel"]
env = { "CI" = "true", "NODE_ENV" = "production" }

[deployment.run]
args = ["node", "--enable-source-maps", "artifacts/api-server/dist/index.mjs"]
env = { "NODE_ENV" = "production", "PORT" = "8080" }

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
WHOP_COLLECTION_PLAN_ID = "plan_PbcIyC0wLtXWO"
WHOP_COMPANY_ID = "biz_tS4fzomuhFr7qv"
WHOP_PROMPT_PLAN_ID = "plan_8ika5j5J2tohe"
